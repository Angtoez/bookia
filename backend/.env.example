# Copia este archivo como backend/.env y rellena los valores.
# backend/.env está en .gitignore: nunca subas credenciales al repositorio.

# Cadena de conexión de MongoDB Atlas (Connect → Drivers). Sustituye <usuario> y <contraseña>
# por los del usuario de base de datos que crees en Atlas (Database Access).
# Si la contraseña tiene caracteres especiales (@ : / ? # [ ] %), codifícalos en URL.
MONGODB_URI=mongodb+srv://<usuario>:<contraseña>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=bookia

# Nombre de la base de datos dentro del clúster (por defecto "bookia").
MONGODB_DB_NAME=bookia

# Secreto para firmar los JWT: cadena aleatoria de al menos 32 caracteres.
# Puedes generarla con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Rondas de bcrypt (mínimo 10).
BCRYPT_ROUNDS=12

# Puerto HTTP de la API.
PORT=3000

# Origen permitido por CORS (solo si la SPA no usa el proxy de Vite). Déjalo vacío si no hace falta.
CORS_ORIGIN=

# Número de proxies delante de la API (en Railway, 1). En local, 0.
TRUST_PROXY=0

# "true" para que la API sirva también la SPA compilada (frontend/dist), como en Railway.
SERVE_FRONTEND=false

# Moneda de los precios (código ISO 4217). Los puntos de venta están en Huauchinango, Puebla.
CURRENCY=MXN

# Reglas de reservas (feature 001; todavía no implementadas en el backend).
MAX_ACTIVE_RESERVATIONS=5
PENDING_TTL_DAYS=7
PICKUP_TTL_DAYS=3
EXPIRATION_INTERVAL_MS=60000

# Administrador inicial que crea "npm run seed" si no existe.
# La contraseña debe tener al menos 8 caracteres, con letras y números.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
