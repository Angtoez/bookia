{
  "name": "bookia",
  "private": true,
  "description": "Bookia: catálogo de libros y puntos de venta",
  "type": "module",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "start": "npm run start -w backend",
    "build": "npm run build -w frontend",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "npm run test --workspaces",
    "seed": "npm run seed -w backend",
    "seed:demo": "npm run seed:demo -w backend",
    "db:check": "npm run db:check -w backend",
    "licenses": "node scripts/checkLicenses.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.6",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10"
  }
}
